+class DeviceAckBindingRegression(MutualTLSRelay):
+    """Standalone negative tests for nonexistent or other-device ACK."""
+
+    def test_an_unknown_call_id_must_not_be_acknowledged(self):
+        status, body = self.post_tls(
+            "/device/ack",
+            {"call_id": "no-call-with-this-id", "device_id": "joyner"},
+            token=self.device_token("joyner"),
+            device_id="joyner",
+        )
+        self.assertEqual(status, 404, body)
+
+
+    def test_another_device_cannot_ack_a_dispatched_call(self):
+        # Dispatch using an explicit test-only ID; no device process is
+        # started, so the call remains queued while this request is sent.
+        call_id = "isolated-owned-call-ack-negative"
+        outcome = {}
+
+        def dispatch():
+            outcome["response"] = self.op_post(
+                "/dispatch",
+                {"device_id": "x1-370", "call_id": call_id,
+                 "argv": ["uname", "-s"], "timeout": 2},
+                timeout=35,
+            )
+
+        worker = threading.Thread(target=dispatch, daemon=True)
+        worker.start()
+        try:
+            time.sleep(0.3)
+            status, body = self.post_tls(
+                "/device/ack", {"call_id": call_id, "device_id": "joyner"},
+                token=self.device_token("joyner"), device_id="joyner",
+            )
+            self.assertEqual(status, 403, body)
+        finally:
+            worker.join(25)
+        self.assertFalse(worker.is_alive())
+        self.assertIn("response", outcome)
