# Router — strict offline fleet mode
AUTO_ROUTER_HOST=0.0.0.0
AUTO_ROUTER_PORT=8088
AUTO_ROUTER_STRICT_OFFLINE=true
AUTO_ROUTER_PROVIDER_CONFIG=config/providers.yaml
AUTO_ROUTER_POLICY_CONFIG=config/policies.yaml
AUTO_ROUTER_AGENT_CONFIG=config/agent_workers.yaml

# Discovery and routing are allowed to observe local runtimes. Model mutation
# remains disabled until an operator reviews the recovered inventory.
AUTO_ROUTER_AUTOLOAD_ENABLED=false
AUTO_ROUTER_PLACEMENT_UNLOAD=false
AUTO_ROUTER_FLEET_DISPATCHER_ENABLED=true
AUTO_ROUTER_AGENTGATEWAY_ENABLED=false
AUTO_ROUTER_GATEWAY_MODE=direct
AUTO_ROUTER_DISCOVERY_TIMEOUT_SECONDS=3

# Add an exceptional local hostname only when it cannot be represented as loopback,
# RFC1918, Tailscale CGNAT, .lan, .local, .internal, .ts.net, or a Docker service name.
AUTO_ROUTER_OFFLINE_ALLOWED_HOSTS=

# Canonical state and routing evidence come from AssistX/Neo4j. Runtime projections
# are schema-v2 Ed25519 documents; the router receives only the public key.
AUTO_ROUTER_CONTEXT_CONFIG=http://assistx-api:8000/api/router/context-projection
AUTO_ROUTER_RUNTIME_PROJECTION_URL=http://assistx-api:8000/api/router/runtime-projection
AUTO_ROUTER_RUNTIME_PROJECTION_VERIFY_KEY_FILE=/run/secrets/assistx_runtime_projection_public_key.pem
AUTO_ROUTER_RUNTIME_PROJECTION_KEY_ID=assistx-runtime-projection-v1
AUTO_ROUTER_RUNTIME_PROJECTION_INTERVAL_SECONDS=5
AUTO_ROUTER_RUNTIME_PROJECTION_TIMEOUT_SECONDS=10
AUTO_ROUTER_PROJECTION_MAX_TTL_MS=900000
AUTO_ROUTER_PROJECTION_CLOCK_SKEW_MS=300000
AUTO_ROUTER_ASSISTX_EVENT_SINK_URL=http://assistx-api:8000/api/events
AUTO_ROUTER_ASSISTX_EVENT_DISPATCH_TIMEOUT_SECONDS=10
AUTO_ROUTER_ASSISTX_EVENT_DISPATCH_MAX_ATTEMPTS=5
AUTO_ROUTER_ASSISTX_BASIC_AUTH_USER=admin
AUTO_ROUTER_ASSISTX_BASIC_AUTH_PASS=change-me
AUTO_ROUTER_ASSISTX_TASKS_URL=http://assistx-api:8000/api/router/backlog-candidates
AUTO_ROUTER_ASSISTX_TASKS_TIMEOUT_SECONDS=10

# Data-plane credentials are intentionally separate. The internal service token is
# for AssistX-owned calls only; task execution uses short-lived Ed25519 task tokens.
AUTO_ROUTER_ADMIN_TOKEN=change-me-shadow-router-admin
AUTO_ROUTER_INTERNAL_SERVICE_TOKEN=change-me-assistx-internal-service
AUTO_ROUTER_EXECUTOR_AUTH_REQUIRED=true
AUTO_ROUTER_EXECUTOR_VERIFY_KEY_FILE=/run/secrets/assistx_executor_public_key.pem
AUTO_ROUTER_EXECUTOR_KEY_ID=assistx-executor-v1
AUTO_ROUTER_EXECUTOR_CLAIM_STATUS_URL=http://assistx-api:8000
AUTO_ROUTER_ASSISTX_EXECUTOR_SERVICE_TOKEN=change-me-router-claim-status-service
AUTO_ROUTER_EXECUTOR_CLAIM_TIMEOUT_SECONDS=2

AUTO_ROUTER_REDIS_URL=redis://localhost:6379/0
AUTO_ROUTER_DATABASE_URL=sqlite:///./data/router.sqlite3
AUTO_ROUTER_LOG_PROMPTS=false
AUTO_ROUTER_DEFAULT_PROFILE=local_only
AUTO_ROUTER_REQUEST_TIMEOUT_SECONDS=120
AUTO_ROUTER_ATTEMPT_TIMEOUT_SECONDS=45
AUTO_ROUTER_CONNECT_TIMEOUT_SECONDS=5
AUTO_ROUTER_REQUEST_DEADLINE_SECONDS=90
AUTO_ROUTER_MAX_CANDIDATE_ATTEMPTS=4
AUTO_ROUTER_LIVE_MODEL_CACHE_TTL_SECONDS=60
AUTO_ROUTER_ACCESS_PATH_TTL_SECONDS=15
AUTO_ROUTER_ACCESS_PATH_PROBE_TIMEOUT_SECONDS=2

# Local physical runtime endpoints.
LMSTUDIO_X1_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_XWING_BASE_URL=http://xwing.tailcb8954.ts.net:1234/v1
LMSTUDIO_DEATHSTAR_BASE_URL=http://100.78.106.121:1234/v1
LMSTUDIO_BEELINK_BASE_URL=http://100.85.72.121:1234/v1
LMSTUDIO_LENOVO_BASE_URL=http://scott-lenovo-ideapad-330s-15ikb.tailcb8954.ts.net:1234/v1
LMSTUDIO_OPTIPLEX_BASE_URL=http://scott-optiplex-9030-aio.tailcb8954.ts.net:1234/v1
LMSTUDIO_MACBOOK_AIR_BASE_URL=http://scotts-macbook-air.tailcb8954.ts.net:1234/v1
LMSTUDIO_DESTROYER_BASE_URL=http://destroyer.tailcb8954.ts.net:1234/v1
LMSTUDIO_JOYNER_BASE_URL=http://joyner.tailcb8954.ts.net:1234/v1
LMSTUDIO_API_TOKEN=

# One-runtime shadow migration profile. This is not the fleet-wide production
# assignment and must not override discovered loadouts. Prefer the known capable
# x1-370 reasoning model over the emergency 3B tool-call fallback.
RECONCILIATION_ROUTER_PORT=18088
RECONCILIATION_ASSISTX_NETWORK=assistx_reconciliation_shared
ASSISTX_EXECUTOR_PUBLIC_KEY_FILE=/absolute/path/to/executor-public.pem
ASSISTX_RUNTIME_PROJECTION_PUBLIC_KEY_FILE=/absolute/path/to/runtime-projection-public.pem
ASSISTX_EXECUTOR_SERVICE_TOKEN=change-me-router-claim-status-service
ASSISTX_EXECUTOR_KEY_ID=assistx-executor-v1
ASSISTX_RUNTIME_PROJECTION_KEY_ID=assistx-runtime-projection-v1
RECONCILIATION_RUNTIME_NODE_ID=x1-370
RECONCILIATION_RUNTIME_INSTANCE_ID=lmstudio-x1-370-1234
RECONCILIATION_RUNTIME_KIND=lmstudio
RECONCILIATION_RUNTIME_VERSION=change-me-from-lms-ps
RECONCILIATION_RUNTIME_HEADLESS=false
RECONCILIATION_PARALLEL_SLOTS=1
RECONCILIATION_QUEUE_LIMIT=4
RECONCILIATION_QUEUE_TIMEOUT_SECONDS=30
RECONCILIATION_LAN_BASE_URL=http://192.168.1.50:1234/v1
RECONCILIATION_LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
RECONCILIATION_TAILSCALE_BASE_URL=http://100.64.43.123:1234/v1
RECONCILIATION_MODEL_ID=ornith-1.0-35b
RECONCILIATION_MODEL_INSTANCE_ID=change-me-from-lms-ps
RECONCILIATION_MODEL_ARTIFACT_FINGERPRINT=change-me-sha256
RECONCILIATION_MODEL_QUANTIZATION=change-me
RECONCILIATION_CONTEXT_WINDOW=131072

AUTO_ROUTER_MEMORY_ENABLED=true
AUTO_ROUTER_MEMORY_SERVICE_URL=
AUTO_ROUTER_MEMORY_TIMEOUT_SECONDS=5
AUTO_ROUTER_MEMORY_CONTEXT_BUDGET_TOKENS=3000
AUTO_ROUTER_MEMORY_QUERY_LIMIT=8

AUTO_ROUTER_AGENTGATEWAY_FAIL_OPEN_TO_DIRECT=false
AUTO_ROUTER_AGENTGATEWAY_FAIL_CLOSED_FOR_PRIVATE=true
AUTO_ROUTER_OTEL_ENABLED=false
AUTO_ROUTER_OTEL_ENDPOINT=http://otel-collector:4317

OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
CLOUDFLARE_API_TOKEN=
XAI_API_KEY=
ANTHROPIC_API_KEY=