# Router
AUTO_ROUTER_HOST=0.0.0.0
AUTO_ROUTER_PORT=8088
AUTO_ROUTER_PROVIDER_CONFIG=config/providers.yaml
AUTO_ROUTER_POLICY_CONFIG=config/policies.yaml
AUTO_ROUTER_AGENT_CONFIG=config/agent_workers.yaml
# Context projection. Canonical truth is AssistX/Neo4j; the router consumes it
# over HTTP. This is the recommended default (LLD §3.5 W-58/W-59). A local
# static snapshot is NOT committed (see archive/context.yaml.static-fallback).
AUTO_ROUTER_CONTEXT_CONFIG=http://assistx:8000/api/router/context-projection
AUTO_ROUTER_REDIS_URL=redis://localhost:6379/0
AUTO_ROUTER_DATABASE_URL=sqlite:///./data/router.sqlite3
AUTO_ROUTER_LOG_PROMPTS=false
AUTO_ROUTER_DEFAULT_PROFILE=interactive_balanced
AUTO_ROUTER_REQUEST_TIMEOUT_SECONDS=120
AUTO_ROUTER_LIVE_MODEL_CACHE_TTL_SECONDS=3600

# AssistX / Neo4j alignment
# Use this once AssistX exposes the graph-backed projection endpoint.
# AUTO_ROUTER_CONTEXT_CONFIG=http://assistx:8000/api/router/context-projection
# Event sink target for pending outbox dispatcher work.
AUTO_ROUTER_ASSISTX_EVENT_SINK_URL=http://assistx:8000/api/events
AUTO_ROUTER_ASSISTX_EVENT_DISPATCH_TIMEOUT_SECONDS=10
AUTO_ROUTER_ASSISTX_EVENT_DISPATCH_MAX_ATTEMPTS=5
# Read-only backlog task intake for dry-run scheduling.
AUTO_ROUTER_ASSISTX_TASKS_URL=http://assistx:8000/api/router/backlog-candidates
AUTO_ROUTER_ASSISTX_TASKS_TIMEOUT_SECONDS=10

# Fleet experience memory. Until auto-memory is extracted, this may target an
# AssistX Neo4j-backed implementation. Empty URL uses the router-local cache.
AUTO_ROUTER_MEMORY_ENABLED=true
AUTO_ROUTER_MEMORY_SERVICE_URL=
AUTO_ROUTER_MEMORY_TIMEOUT_SECONDS=5
AUTO_ROUTER_MEMORY_CONTEXT_BUDGET_TOKENS=3000
AUTO_ROUTER_MEMORY_QUERY_LIMIT=8

# API providers
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ZAI_API_KEY=
OPENROUTER_API_KEY=

# Local endpoints
LMSTUDIO_R2D2_BASE_URL=http://r2d2:1234/v1
LMSTUDIO_DEATHSTAR_BASE_URL=http://deathstar-XPS-8920:1234/v1

# Agentgateway integration
# Default (docker-compose) runs in DIRECT mode with the sidecar DISABLED.
# To use the agentgateway sidecar, set the overlay (docker-compose.agentgateway.yml)
# or flip these to sidecar/true locally.
AUTO_ROUTER_GATEWAY_MODE=direct
AUTO_ROUTER_AGENTGATEWAY_ENABLED=false
AUTO_ROUTER_AGENTGATEWAY_BASE_URL=http://agentgateway:3000
AUTO_ROUTER_AGENTGATEWAY_OPENAI_BASE_URL=http://agentgateway:3000/v1
AUTO_ROUTER_AGENTGATEWAY_TIMEOUT_SECONDS=120
AUTO_ROUTER_AGENTGATEWAY_FAIL_OPEN_TO_DIRECT=true
AUTO_ROUTER_AGENTGATEWAY_FAIL_CLOSED_FOR_PRIVATE=true
AUTO_ROUTER_AGENTGATEWAY_EMIT_HEADERS=true
AUTO_ROUTER_AGENTGATEWAY_PASS_METADATA_IN_BODY=true
AUTO_ROUTER_AGENTGATEWAY_RECONCILE_USAGE=true

# Observability
AUTO_ROUTER_OTEL_ENABLED=false
AUTO_ROUTER_OTEL_ENDPOINT=http://otel-collector:4317
AGENTGATEWAY_OTEL_ENDPOINT=http://otel-collector:4317

# Agentgateway metrics (optional)
AUTO_ROUTER_AGENTGATEWAY_METRICS_URL=http://agentgateway:15020/metrics
AUTO_ROUTER_AGENTGATEWAY_METRICS_ENABLED=true

# Hosted provider keys used by agentgateway
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Operator safety notes
# Keep prompt logging off unless debugging a non-sensitive local-only path.
# External service probing is disabled by default in the service scanner endpoint.
# Agent CLIs are discovered separately from policy enablement.
# Backlog task intake is dry-run/read-only until AssistX approvals are implemented.
