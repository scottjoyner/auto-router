# Router — strict offline fleet mode
AUTO_ROUTER_HOST=0.0.0.0
AUTO_ROUTER_PORT=8088
AUTO_ROUTER_STRICT_OFFLINE=true
AUTO_ROUTER_PROVIDER_CONFIG=config/providers.yaml
AUTO_ROUTER_POLICY_CONFIG=config/policies.yaml
AUTO_ROUTER_AGENT_CONFIG=config/agent_workers.yaml

# Add an exceptional local hostname only when it cannot be represented as loopback,
# RFC1918, Tailscale CGNAT, .lan, .local, .internal, .ts.net, or a Docker service name.
AUTO_ROUTER_OFFLINE_ALLOWED_HOSTS=

# Canonical state and routing evidence come from AssistX/Neo4j.
AUTO_ROUTER_CONTEXT_CONFIG=http://assistx:8000/api/router/context-projection
AUTO_ROUTER_ASSISTX_EVENT_SINK_URL=http://assistx:8000/api/events
AUTO_ROUTER_ASSISTX_EVENT_DISPATCH_TIMEOUT_SECONDS=10
AUTO_ROUTER_ASSISTX_EVENT_DISPATCH_MAX_ATTEMPTS=5
AUTO_ROUTER_ASSISTX_TASKS_URL=http://assistx:8000/api/router/backlog-candidates
AUTO_ROUTER_ASSISTX_TASKS_TIMEOUT_SECONDS=10

# Local router state is cache/outbox only.
AUTO_ROUTER_REDIS_URL=redis://localhost:6379/0
AUTO_ROUTER_DATABASE_URL=sqlite:///./data/router.sqlite3
AUTO_ROUTER_LOG_PROMPTS=false
AUTO_ROUTER_DEFAULT_PROFILE=interactive_balanced
AUTO_ROUTER_REQUEST_TIMEOUT_SECONDS=120
AUTO_ROUTER_LIVE_MODEL_CACHE_TTL_SECONDS=60

# Local physical runtime endpoints. LM Studio Link access URLs must still be
# reconciled to their physical runtime node before they become routable.
LMSTUDIO_X1_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_XWING_BASE_URL=http://xwing.tailcb8954.ts.net:1234/v1
LMSTUDIO_DEATHSTAR_BASE_URL=http://100.78.106.121:1234/v1
LMSTUDIO_BEELINK_BASE_URL=http://100.85.72.121:1234/v1
LMSTUDIO_LENOVO_BASE_URL=http://scott-lenovo-ideapad-330s-15ikb.tailcb8954.ts.net:1234/v1
LMSTUDIO_OPTIPLEX_BASE_URL=http://scott-optiplex-9030-aio.tailcb8954.ts.net:1234/v1
LMSTUDIO_MACBOOK_AIR_BASE_URL=http://scotts-macbook-air.tailcb8954.ts.net:1234/v1
LMSTUDIO_DESTROYER_BASE_URL=http://destroyer.tailcb8954.ts.net:1234/v1
LMSTUDIO_JOYNER_BASE_URL=http://joyner.tailcb8954.ts.net:1234/v1

# Fleet experience memory. Prefer an AssistX/Neo4j-backed service; an empty URL
# keeps the router in local degraded mode.
AUTO_ROUTER_MEMORY_ENABLED=true
AUTO_ROUTER_MEMORY_SERVICE_URL=
AUTO_ROUTER_MEMORY_TIMEOUT_SECONDS=5
AUTO_ROUTER_MEMORY_CONTEXT_BUDGET_TOKENS=3000
AUTO_ROUTER_MEMORY_QUERY_LIMIT=8

# Broker gateways and public-provider fail-open behavior are forbidden here.
AUTO_ROUTER_GATEWAY_MODE=direct
AUTO_ROUTER_AGENTGATEWAY_ENABLED=false
AUTO_ROUTER_AGENTGATEWAY_FAIL_OPEN_TO_DIRECT=false
AUTO_ROUTER_AGENTGATEWAY_FAIL_CLOSED_FOR_PRIVATE=true

# OpenTelemetry must point to a local collector when enabled.
AUTO_ROUTER_OTEL_ENABLED=false
AUTO_ROUTER_OTEL_ENDPOINT=http://otel-collector:4317

# Keep prompt logging off. Admin endpoints remain locked until a local token is set.
AUTO_ROUTER_ADMIN_TOKEN=
