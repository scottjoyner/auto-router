# Router
AUTO_ROUTER_HOST=0.0.0.0
AUTO_ROUTER_PORT=8088
AUTO_ROUTER_PROVIDER_CONFIG=config/providers.yaml
AUTO_ROUTER_POLICY_CONFIG=config/policies.yaml
AUTO_ROUTER_AGENT_CONFIG=config/agent_workers.yaml
AUTO_ROUTER_CONTEXT_CONFIG=config/context.yaml
AUTO_ROUTER_REDIS_URL=redis://localhost:6379/0
AUTO_ROUTER_DATABASE_URL=sqlite:///./data/router.sqlite3
AUTO_ROUTER_LOG_PROMPTS=false
AUTO_ROUTER_DEFAULT_PROFILE=interactive_balanced
AUTO_ROUTER_REQUEST_TIMEOUT_SECONDS=120
AUTO_ROUTER_LIVE_MODEL_CACHE_TTL_SECONDS=3600

# AssistX / Neo4j alignment
# Use this once AssistX exposes the graph-backed projection endpoint.
# AUTO_ROUTER_CONTEXT_CONFIG=http://assistx:8000/api/router/context-projection
# Event sink target for pending outbox dispatcher work.
AUTO_ROUTER_ASSISTX_EVENT_SINK_URL=http://assistx:8000/api/events
AUTO_ROUTER_ASSISTX_EVENT_DISPATCH_TIMEOUT_SECONDS=10
AUTO_ROUTER_ASSISTX_EVENT_DISPATCH_MAX_ATTEMPTS=5
# Read-only backlog task intake for dry-run scheduling.
AUTO_ROUTER_ASSISTX_TASKS_URL=http://assistx:8000/api/router/backlog-candidates
AUTO_ROUTER_ASSISTX_TASKS_TIMEOUT_SECONDS=10

# API providers
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ZAI_API_KEY=
OPENROUTER_API_KEY=

# Local endpoints
LMSTUDIO_R2D2_BASE_URL=http://r2d2:1234/v1
LMSTUDIO_DEATHSTAR_BASE_URL=http://deathstar-XPS-8920:1234/v1

# Operator safety notes
# Keep prompt logging off unless debugging a non-sensitive local-only path.
# External service probing is disabled by default in the service scanner endpoint.
# Agent CLIs are discovered separately from policy enablement.
# Backlog task intake is dry-run/read-only until AssistX approvals are implemented.
